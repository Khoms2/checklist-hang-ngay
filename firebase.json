{
  "hosting": {
    "site": "dailychecklist-k",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebase/**",
      "**/.*",
      "node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
